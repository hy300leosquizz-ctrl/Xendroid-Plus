#version 460
// RC6: the RC5 dense flow's proposal for each D4 cell. One invocation per cell: the median of each component of the dense A -> B flow over
// the cell's footprint at the flow's level (the laboratory's form: the element at count / 2 of each sorted component, at most 64 samples),
// scaled to source pixels, written after the camera hypotheses (camera[256 + cell] = x, y, 0, valid; under 4 samples: not valid). The flow
// must agree with itself inside the cell: when the median absolute deviation of either component around its median exceeds max_spread
// source pixels (rain, flowing water, a texture that does not move as one), the cell gets no proposal.
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) readonly buffer Flow {
  vec2 flow[];
};
layout(std430, binding = 1) buffer Camera {
  vec4 camera[];
};

layout(push_constant) uniform Push {
  ivec2 field_extent;  // the D4 cells
  ivec2 flow_extent;   // the dense flow's level
  int flow_offset;     // vec2s into the flow buffer
  float cell_w;        // a cell's size in flow pixels (the run extent over the cells, over the scale)
  float cell_h;
  float scale;         // source pixels per flow pixel
  float max_spread;    // source pixels (0 = no test)
} pc;

float xs[64], ys[64];
int n = 0;

// The k-th smallest of the first n values (as std::nth_element at k): the value whose rank range [less, less + equal) holds k.
float KthX(int k) {
  float m = xs[0];
  for (int i = 0; i < n; ++i) {
    int l = 0, e = 0;
    for (int j = 0; j < n; ++j) {
      l += xs[j] < xs[i] ? 1 : 0;
      e += xs[j] == xs[i] ? 1 : 0;
    }
    if (l <= k && k < l + e) m = xs[i];
  }
  return m;
}

float KthY(int k) {
  float m = ys[0];
  for (int i = 0; i < n; ++i) {
    int l = 0, e = 0;
    for (int j = 0; j < n; ++j) {
      l += ys[j] < ys[i] ? 1 : 0;
      e += ys[j] == ys[i] ? 1 : 0;
    }
    if (l <= k && k < l + e) m = ys[i];
  }
  return m;
}

void main() {
  ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
  if (cell.x >= pc.field_extent.x || cell.y >= pc.field_extent.y) return;
  int x0 = max(0, int(float(cell.x) * pc.cell_w)), x1 = min(pc.flow_extent.x, int(float(cell.x + 1) * pc.cell_w));
  int y0 = max(0, int(float(cell.y) * pc.cell_h)), y1 = min(pc.flow_extent.y, int(float(cell.y + 1) * pc.cell_h));
  for (int y = y0; y < y1; ++y)
    for (int x = x0; x < x1; ++x) {
      if (n < 64) {
        vec2 f = flow[pc.flow_offset + y * pc.flow_extent.x + x];
        xs[n] = f.x;
        ys[n] = f.y;
        ++n;
      }
    }
  vec4 result = vec4(0.0);
  if (n >= 4) {
    int k = n / 2;
    float mx = KthX(k), my = KthY(k);
    result = vec4(mx * pc.scale, my * pc.scale, 0.0, 1.0);
    if (pc.max_spread > 0.0) {
      for (int i = 0; i < n; ++i) {
        xs[i] = abs(xs[i] - mx);
        ys[i] = abs(ys[i] - my);
      }
      if (max(KthX(k), KthY(k)) * pc.scale > pc.max_spread) result = vec4(0.0);
    }
  }
  camera[256 + cell.y * pc.field_extent.x + cell.x] = result;
}
